__pycache__/
*.pyc
*.egg-info/
.DS_Store

# run artifacts
*.sqlite
*.pickle
# ...but the bundled demonstration datasets must ship
!examples/data/*.pickle
out/
examples/out_li_ec/
runs/
workdir*/
*_chunks/
*_outputs/
*_logs/
*.out
*.error
slurm-*.log

# editor and rescue copies
*.bak
*.bak_*
*.orig

# committed reference output of the example (examples/out_li_ec itself stays
# ignored so a fresh clone's run starts clean instead of resuming this one)
!examples/reference_output/**
examples/reference_output/**/.DS_Store
